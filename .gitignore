# Data: only the tables and reduced maps in data/processed/ are versioned.
# The MapBiomas files in data/raw/ are downloaded or placed by hand (the 30 m
# mosaics are about 1 to 2 GB each).
data/*
!data/processed/
!data/raw/
data/raw/*
!data/raw/.gitkeep

